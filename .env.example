# Copy to .env (which git ignores) and fill in. Never commit real values.

# QuickBooks Online (developer.intuit.com > your app > Keys and credentials > Development)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# From the Intuit OAuth 2.0 Playground. The script saves the rotated token back here.
QBO_REFRESH_TOKEN=
# The sandbox company ID ("Realm ID")
QBO_REALM_ID=
QBO_ENVIRONMENT=sandbox

# Slack incoming webhook. Apps Script reads it from Script Properties, not from this file.
# It is listed here only so every secret is documented in one place.
SLACK_WEBHOOK_URL=
